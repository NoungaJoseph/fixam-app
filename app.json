{
  "expo": {
    "name": "Fixam",
    "slug": "Fixam",
    "version": "1.1.3",
    "scheme": "fixam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/fixam.png",
      "resizeMode": "contain",
      "backgroundColor": "#14B8A6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixam.app.iosapp",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "buildNumber": "29",
      "userInterfaceStyle": "automatic",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIUserInterfaceStyle": "Automatic",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Fixam uses your location to discover verified service providers and available jobs near you (for example, finding plumbers or electricians in your neighborhood), and to calculate accurate travel distances to service addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Fixam uses your location to notify you of nearby task requests and provide live arrival tracking when a service provider is en route to your location.",
        "NSLocationAlwaysUsageDescription": "Fixam uses your location to notify you of nearby task requests and provide live arrival tracking when a service provider is en route to your location.",
        "NSCameraUsageDescription": "Fixam accesses your camera so you can take profile photos, capture pictures of repair issues when creating a job request, and scan identity verification documents.",
        "NSPhotoLibraryUsageDescription": "Fixam accesses your photo library to let you select and upload pictures of repair tasks, showcase your work portfolio, and update your profile picture.",
        "NSMicrophoneUsageDescription": "Fixam accesses your microphone to allow you to record and send voice audio messages to clients or service providers within task chats."
      },
      "associatedDomains": [
        "applinks:usefixam.com"
      ]
    },
    "android": {
      "package": "com.fixam.app.android",
      "googleServicesFile": "./firebase/google-services.json",
      "versionCode": 24,
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14B8A6"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fixam"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "usefixam.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "usefixam.com",
              "pathPrefix": "/job"
            },
            {
              "scheme": "https",
              "host": "usefixam.com",
              "pathPrefix": "/download"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "./plugins/withStripMediaPermissions",
      "expo-dev-client",
      "expo-localization",
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fixam accesses your camera so you can take profile photos, capture pictures of repair issues when creating a job request, and scan identity verification documents.",
          "photosPermission": false,
          "savePhotosPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#14B8A6"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withAndroidFirebaseStabilization",
      "./plugins/withIosFirebaseStabilization",
      [
        "@sentry/react-native/expo",
        {
          "organization": "fixam",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4d46468f-0fb1-40b9-85b2-7c61004d77b9"
      }
    },
    "runtimeVersion": "1.1.3",
    "updates": {
      "url": "https://u.expo.dev/4d46468f-0fb1-40b9-85b2-7c61004d77b9"
    }
  }
}
